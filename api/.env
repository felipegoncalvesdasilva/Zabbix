# Configuração do Zabbix API Tester
# Copie este arquivo para .env e preencha com seus dados
# NÃO compartilhe o arquivo .env em repositórios públicos!

# URL do Zabbix
ZABBIX_URL=http://localhost/zabbix
# ZABBIX_URL=https://zabbix.empresa.com (para ambiente de produção com SSL)

# Credenciais de autenticação
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix

# Configurações opcionais
# Verificar certificado SSL (true/false)
ZABBIX_VERIFY_SSL=false

# Configurações de logging
LOG_LEVEL=INFO
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
